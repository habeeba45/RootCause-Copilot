{
  // Terminal > Run Task... > "Setup: install everything" (run once before the first launch)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: install everything",
      "type": "shell",
      "command": "cd backend; python -m venv .venv; .venv\\Scripts\\python.exe -m pip install -r requirements.txt; cd ..\\frontend; npm install",
      "options": { "cwd": "${workspaceFolder}", "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"] } },
      "problemMatcher": []
    },
    {
      "label": "Regenerate sample data",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe scripts\\generate_samples.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ]
}
