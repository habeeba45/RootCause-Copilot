# Copy this file to backend/.env (it is git-ignored) and restart the backend.
# Keys are read only from environment variables / this file. They are never logged,
# stored with incidents, or sent to the browser.

# --- Option A: Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5

# --- Option B: OpenAI or any OpenAI-compatible API (Azure OpenAI, OpenRouter, Groq, local Ollama ...)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1      # e.g. http://localhost:11434/v1 for Ollama
# LLM_MODEL=gpt-4o-mini

# LLM_PROVIDER=anthropic          # anthropic | openai | none (force rule-based)
# LLM_MAX_STEPS=8                 # follow-up tool calls the LLM planner may make
# LLM_TIMEOUT=60                  # seconds per LLM request

# Seconds between agent steps so the live activity log is readable. Use 0 for instant.
AGENT_STEP_DELAY=0.3
